# Copy to supabase/.env.local (gitignored) and fill in YOUR admin login.
# Used only by scripts/fetch-feedback.sh to read the feedback table for triage.
#
# The email is the synthetic address the app logs you in with: <slug>@muscleup.local,
# where <slug> is your username lowercased with non-alphanumerics turned to '_'
# (see js/auth.js slug()). e.g. username "Dennis" -> dennis@muscleup.local.

SUPABASE_ADMIN_EMAIL=you@muscleup.local
SUPABASE_ADMIN_PASSWORD=your-password
